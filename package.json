{
  "name": "Gokuldroid",
  "private": true,
  "description": "Personal website",
  "version": "0.1.0",
  "author": "Gokul prabhu <gokulprabhu.droid@gmail.com>",
  "dependencies": {
    "gatsby": "^5.16.1",
    "gatsby-awesome-pagination": "^0.3.8",
    "gatsby-plugin-alias-imports": "^1.0.5",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-prismjs-copy-button": "^0.4.0",
    "gatsby-remark-table-of-contents": "^2.0.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.6.0",
    "react-share": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "gatsby-plugin-postcss": "^6.16.0",
    "gh-pages": "^6.3.0",
    "portless": "^0.13.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.0"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "build": "gatsby build",
    "predevelop": "npm run dev:stop --silent",
    "develop": "gatsby develop",
    "develop:proxy": "gatsby develop -H 127.0.0.1",
    "predevelop:portless": "npm run dev:stop --silent",
    "develop:portless": "portless",
    "dev:stop": "portless prune > /dev/null 2>&1 || true; pkill -f \"$PWD/node_modules/.bin/gatsby develop\" 2>/dev/null; true",
    "format": "prettier --write src/**/*.{js,jsx}",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "rm -rf public && rm -rf .cache",
    "test": "echo \"Write tests! -> https://gatsby.app/unit-testing\"",
    "build:pp": "gatsby build --prefix-paths",
    "publish": "npm run clean && npm run build:pp && gh-pages -d public -b master"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gokuldroid/Gokuldroid.github.io"
  },
  "bugs": {
    "url": "https://github.com/Gokuldroid/Gokuldroid.github.io"
  }
}
