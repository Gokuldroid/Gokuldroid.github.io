{"componentChunkName":"component---src-components-module-blog-post-index-jsx","path":"/posts/til-find-process-occupies-a-port/","result":{"data":{"post":{"html":"<p>you can execute the following cmd to find the process which occupies a specific port in linux.</p>\n\n          <div class=\"gatsby-remark-prismjs-copy-button-container\">\n            <div class=\"gatsby-remark-prismjs-copy-button\" tabindex=\"0\" role=\"button\" aria-pressed=\"false\" onclick=\"gatsbyRemarkCopyToClipboard(this, this.parentNode.nextElementSibling)\">\n              Copy\n            </div>\n          </div>\n          \n<div class=\"gatsby-highlight\" data-language=\"text\"><pre class=\"language-text\"><code class=\"language-text\">sudo lsof -i :&lt;port_number> -t | xargs ps -o pid,user,cmd -p</code></pre></div>","excerpt":"you can execute the following cmd to find the process which occupies a specific port in linux.","tableOfContents":"","frontmatter":{"title":"Find process using a port","path":"til-find-process-occupies-a-port","tags":["bash","cmdline"],"parentPath":null}},"parentPost":null,"siblingPosts":{"edges":[]},"previousPost":{"frontmatter":{"title":"Find disk usage sorted by size"}},"nextPost":{"frontmatter":{"title":"Top 10 tools you need as developer"}}},"pageContext":{"parentPath":null,"pageId":"eff004f7-8433-547b-8204-ce78cd7ab1ab","previousPagePath":"/posts/til-find-diskusage-sorted-by-size/","previousItem":{"node":{"id":"73288cab-fc6a-56dc-bbd2-782926e6c644","frontmatter":{"title":"Find disk usage sorted by size","path":"til-find-diskusage-sorted-by-size","parentPath":null,"date":"2023-07-11T17:26:02.000Z","categories":["today I learned"]}},"context":{"parentPath":null}},"previousPageId":"73288cab-fc6a-56dc-bbd2-782926e6c644","nextPagePath":"/posts/top-10-tools-you-need-as-dev/","nextItem":{"node":{"id":"35329ecf-6d63-5597-9919-211acf636c08","frontmatter":{"title":"Top 10 tools you need as developer","path":"top-10-tools-you-need-as-dev","parentPath":null,"date":"2023-0